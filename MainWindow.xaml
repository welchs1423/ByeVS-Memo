<Window x:Class="ByeVS_Memo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ByeVS-Memo"
        Height="450"
        Width="800">
        <Window.CommandBindings>
                <CommandBinding Command="ApplicationCommands.New"
                                Executed="NewCommand_Executed"/>
                <CommandBinding Command="ApplicationCommands.Open"
                                Executed="OpenCommand_Executed"/>
                <CommandBinding Command="ApplicationCommands.Save"
                                Executed="SaveCommand_Executed"/>
        </Window.CommandBindings>
        <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="5,5,5,0">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Menu x:Name="MainMenu"
                              Grid.Row="0"
                              VerticalAlignment="Center"
                              Background="#F0F0F0">
                                <MenuItem x:Name="RecentFilesMenu"
                                          Header="최근 파일"/>
                        </Menu>
                        <StackPanel x:Name="TopPanel"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Background="#F0F0F0"
                                    Margin="0,4,0,0">
                                <Button Content="열기"
                                        Click="OpenButton_Click"
                                        Margin="0,0,5,5"
                                        Width="60"
                                        Height="25"/>
                                <Button Content="저장"
                                        Click="SaveButton_Click"
                                        Margin="0,0,5,5"
                                        Width="60"
                                        Height="25"/>
                                <Button x:Name="ThemeButton"
                                        Content="다크 모드"
                                        Click="ThemeButton_Click"
                                        Margin="0,0,5,5"
                                        Width="100"
                                        Height="25"/>
                                <ToggleButton x:Name="TopmostButton"
                                              Content="📌"
                                              Click="TopmostButton_Click"
                                              Margin="0,0,5,5"
                                              Width="30"
                                              Height="25"
                                              ToolTip="항상 위로 고정"/>
                                <CheckBox x:Name="WordWrapCheckBox"
                                          Content="자동 줄바꿈"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,5"
                                          Checked="WordWrapCheckBox_Changed"
                                          Unchecked="WordWrapCheckBox_Changed"/>
                                <Separator Margin="8,4,8,4"
                                           Width="1"/>
                                <TextBlock Text="투명도"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,5"/>
                                <Slider x:Name="OpacitySlider"
                                        Minimum="0.2"
                                        Maximum="1.0"
                                        Value="1.0"
                                        Width="100"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,5"
                                        ValueChanged="OpacitySlider_ValueChanged"
                                        ToolTip="창 투명도 조절 (20% ~ 100%)"/>
                        </StackPanel>
                </Grid>

                <TextBox x:Name="MainTextBox"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="15"
                         Padding="10"
                         BorderThickness="0"
                         PreviewMouseWheel="MainTextBox_PreviewMouseWheel"
                         SelectionChanged="MainTextBox_SelectionChanged"
                         TextChanged="MainTextBox_TextChanged"/>

                <StatusBar x:Name="MainStatusBar"
                                Grid.Row="2">
                        <StatusBar.ItemsPanel>
                                <ItemsPanelTemplate>
                                        <DockPanel LastChildFill="True"/>
                                </ItemsPanelTemplate>
                        </StatusBar.ItemsPanel>
                        <StatusBarItem DockPanel.Dock="Right">
                                <TextBlock x:Name="ClockText"
                                                Text="00:00:00"
                                                Margin="10,0,5,0"/>
                        </StatusBarItem>
                        <StatusBarItem DockPanel.Dock="Right">
                                <TextBlock x:Name="CharCountText"
                                                Text="글자 수: 0"
                                                Margin="10,0,0,0"/>
                        </StatusBarItem>
                        <StatusBarItem DockPanel.Dock="Right">
                                <TextBlock x:Name="CursorPosText"
                                                Text="줄: 1, 칸: 1"
                                                Margin="10,0,0,0"/>
                        </StatusBarItem>
                        <StatusBarItem/>
                </StatusBar>
        </Grid>
</Window>