<Window x:Class="ByeVS_Memo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ByeVS_Memo"
        Title="ByeVS-Memo"
        Height="450"
        Width="800"
        KeyDown="Window_KeyDown">
        <Window.InputBindings>
                <KeyBinding Key="F5"
                                Command="{x:Static local:MainWindow.InsertTimestampCommand}"/>
                <KeyBinding Key="F8"
                                Command="{x:Static local:MainWindow.ToggleMarkdownPreviewCommand}"/>
                <KeyBinding Key="F12"
                                Command="{x:Static local:MainWindow.ToggleStickyNoteModeCommand}"/>
        </Window.InputBindings>
        <Window.CommandBindings>
                <CommandBinding Command="ApplicationCommands.New"
                                Executed="NewCommand_Executed"/>
                <CommandBinding Command="ApplicationCommands.Open"
                                Executed="OpenCommand_Executed"/>
                <CommandBinding Command="ApplicationCommands.Save"
                                Executed="SaveCommand_Executed"/>
                <CommandBinding Command="ApplicationCommands.Print"
                                Executed="PrintCommand_Executed"/>
                <CommandBinding Command="{x:Static local:MainWindow.InsertTimestampCommand}"
                                Executed="InsertTimestampCommand_Executed"/>
                <CommandBinding Command="{x:Static local:MainWindow.ToggleStickyNoteModeCommand}"
                                Executed="ToggleStickyNoteModeCommand_Executed"/>
                <CommandBinding Command="{x:Static local:MainWindow.ToggleMarkdownPreviewCommand}"
                                Executed="ToggleMarkdownPreviewCommand_Executed"/>
        </Window.CommandBindings>
        <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="TopPanelContainer"
                      Grid.Row="0"
                      Margin="5,5,5,0">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Menu x:Name="MainMenu"
                              Grid.Row="0"
                              VerticalAlignment="Center"
                              Background="#F0F0F0">
                                <MenuItem x:Name="RecentFilesMenu"
                                          Header="최근 파일"/>
                        </Menu>
                        <StackPanel x:Name="TopPanel"
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Background="#F0F0F0"
                                    Margin="0,4,0,0">
                                <Button Content="열기"
                                        Click="OpenButton_Click"
                                        Margin="0,0,5,5"
                                        Width="60"
                                        Height="25"/>
                                <Button Content="저장"
                                        Click="SaveButton_Click"
                                        Margin="0,0,5,5"
                                        Width="60"
                                        Height="25"/>
                                <Button Content="통계"
                                        Click="StatsButton_Click"
                                        Margin="0,0,5,5"
                                        Width="60"
                                        Height="25"
                                        ToolTip="문서 통계 보기"/>
                                <Button x:Name="ThemeButton"
                                        Content="다크 모드"
                                        Click="ThemeButton_Click"
                                        Margin="0,0,5,5"
                                        Width="100"
                                        Height="25"/>
                                <ToggleButton x:Name="TopmostButton"
                                              Content="📌"
                                              Click="TopmostButton_Click"
                                              Margin="0,0,5,5"
                                              Width="30"
                                              Height="25"
                                              ToolTip="항상 위로 고정"/>
                                <CheckBox x:Name="WordWrapCheckBox"
                                          Content="자동 줄바꿈"
                                          VerticalAlignment="Center"
                                          Margin="10,0,0,5"
                                          Checked="WordWrapCheckBox_Changed"
                                          Unchecked="WordWrapCheckBox_Changed"/>
                                <Separator Margin="8,4,8,4"
                                           Width="1"/>
                                <TextBlock Text="투명도"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,5"/>
                                <Slider x:Name="OpacitySlider"
                                        Minimum="0.2"
                                        Maximum="1.0"
                                        Value="1.0"
                                        Width="100"
                                        VerticalAlignment="Center"
                                        Margin="0,0,5,5"
                                        ValueChanged="OpacitySlider_ValueChanged"
                                        ToolTip="창 투명도 조절 (20% ~ 100%)"/>
                                <Button x:Name="StickyNoteButton"
                                        Content="🗒️ 포스트잇"
                                        Click="StickyNoteButton_Click"
                                        Margin="0,0,5,5"
                                        Width="80"
                                        Height="25"
                                        ToolTip="포스트잇 모드 전환 (F12)"/>
                                <ToggleButton x:Name="MdPreviewButton"
                                             Content="MD 미리보기"
                                             Click="MdPreviewButton_Click"
                                             Margin="0,0,5,5"
                                             Width="95"
                                             Height="25"
                                             ToolTip="마크다운 미리보기 토글 (F8)"/>
                                <ToggleButton x:Name="OutlineButton"
                                             Content="개요"
                                             Click="OutlineButton_Click"
                                             Margin="0,0,5,5"
                                             Width="60"
                                             Height="25"
                                             ToolTip="문서 개요 패널 토글"/>
                        </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 검색/바꾸기 패널 -->
                        <Border x:Name="SearchPanel"
                                Grid.Row="0"
                                Visibility="Collapsed"
                                BorderThickness="0,1,0,1"
                                BorderBrush="#CCCCCC"
                                Padding="5,4"
                                Background="#F0F0F0">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                        <TextBlock x:Name="FindLabel"
                                                   Text="찾기:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <TextBox x:Name="FindTextBox"
                                                 Width="150"
                                                 Height="22"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 KeyDown="FindTextBox_KeyDown"/>
                                        <TextBlock x:Name="ReplaceLabel"
                                                   Text="바꾸기:"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"
                                                   Visibility="Collapsed"/>
                                        <TextBox x:Name="ReplaceTextBox"
                                                 Width="150"
                                                 Height="22"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,6,0"
                                                 Visibility="Collapsed"
                                                 KeyDown="ReplaceTextBox_KeyDown"/>
                                        <Button Content="다음 찾기"
                                                Height="22"
                                                Padding="6,0"
                                                Margin="0,0,3,0"
                                                Click="FindNext_Click"/>
                                        <Button x:Name="ReplaceButton"
                                                Content="바꾸기"
                                                Height="22"
                                                Padding="6,0"
                                                Margin="0,0,3,0"
                                                Visibility="Collapsed"
                                                Click="Replace_Click"/>
                                        <Button x:Name="ReplaceAllButton"
                                                Content="모두 바꾸기"
                                                Height="22"
                                                Padding="6,0"
                                                Margin="0,0,3,0"
                                                Visibility="Collapsed"
                                                Click="ReplaceAll_Click"/>
                                        <Button Content="닫기"
                                                Height="22"
                                                Padding="6,0"
                                                Click="CloseSearch_Click"/>
                                        <TextBlock x:Name="SearchStatusText"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="#888888"
                                                   FontSize="11"/>
                                </StackPanel>
                        </Border>

                        <!-- 에디터 + 미리보기 + 개요 분할 레이아웃 -->
                        <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition x:Name="SplitterColumn" Width="0"/>
                                        <ColumnDefinition x:Name="PreviewColumn" Width="0"/>
                                        <ColumnDefinition x:Name="OutlineSplitterColumn" Width="0"/>
                                        <ColumnDefinition x:Name="OutlineColumn" Width="0"/>
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: 줄 번호 + 텍스트 에디터 -->
                                <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="45"/>
                                                <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="LineNumberBorder"
                                                Grid.Column="0"
                                                Background="#E8E8E8">
                                            <ScrollViewer x:Name="LineNumberScroller"
                                                          VerticalScrollBarVisibility="Hidden"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          IsHitTestVisible="False"
                                                          Focusable="False">
                                                <TextBlock x:Name="LineNumbersText"
                                                           Text="1"
                                                           FontSize="15"
                                                           TextAlignment="Right"
                                                           Padding="0,10,6,10"
                                                           Foreground="#777777"/>
                                            </ScrollViewer>
                                        </Border>
                                        <TextBox x:Name="MainTextBox"
                                                 Grid.Column="1"
                                                 AcceptsReturn="True"
                                                 AcceptsTab="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontSize="15"
                                                 Padding="10"
                                                 BorderThickness="0"
                                                 AllowDrop="True"
                                                 PreviewDragOver="MainTextBox_PreviewDragOver"
                                                 Drop="MainTextBox_Drop"
                                                 PreviewMouseWheel="MainTextBox_PreviewMouseWheel"
                                                 PreviewMouseLeftButtonDown="MainTextBox_PreviewMouseLeftButtonDown"
                                                 PreviewMouseMove="MainTextBox_PreviewMouseMove"
                                                 PreviewMouseLeftButtonUp="MainTextBox_PreviewMouseLeftButtonUp"
                                                 PreviewKeyDown="MainTextBox_PreviewKeyDown"
                                                 SelectionChanged="MainTextBox_SelectionChanged"
                                                 TextChanged="MainTextBox_TextChanged"
                                                 ScrollViewer.ScrollChanged="MainTextBox_ScrollChanged">
                                            <TextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="대문자로 변환 (UPPERCASE)" Click="MenuItem_Uppercase_Click"/>
                                                    <MenuItem Header="소문자로 변환 (lowercase)" Click="MenuItem_Lowercase_Click"/>
                                                    <MenuItem Header="빈 줄 모두 제거 (Remove Empty Lines)" Click="MenuItem_RemoveEmptyLines_Click"/>
                                                </ContextMenu>
                                            </TextBox.ContextMenu>
                                        </TextBox>
                                </Grid>

                                <!-- Col 1: 분할선 -->
                                <GridSplitter x:Name="PreviewSplitter"
                                              Grid.Column="1"
                                              Width="4"
                                              HorizontalAlignment="Stretch"
                                              Background="#CCCCCC"
                                              Visibility="Collapsed"/>

                                <!-- Col 2: 마크다운 미리보기 -->
                                <WebBrowser x:Name="MarkdownPreviewBrowser"
                                            Grid.Column="2"
                                            Visibility="Collapsed"/>

                                <!-- Col 3: 개요 패널 분할선 -->
                                <GridSplitter x:Name="OutlineSplitter"
                                              Grid.Column="3"
                                              Width="4"
                                              HorizontalAlignment="Stretch"
                                              Background="#CCCCCC"
                                              Visibility="Collapsed"/>

                                <!-- Col 4: 문서 개요 패널 -->
                                <Border x:Name="OutlinePanelBorder"
                                        Grid.Column="4"
                                        Visibility="Collapsed"
                                        Background="#F0F0F0"
                                        BorderThickness="0">
                                        <Grid>
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock x:Name="OutlinePanelTitle"
                                                           Grid.Row="0"
                                                           Text="문서 개요"
                                                           FontWeight="SemiBold"
                                                           FontSize="12"
                                                           Padding="8,6,8,4"/>
                                                <ListBox x:Name="OutlineListBox"
                                                         Grid.Row="1"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         SelectionChanged="OutlineListBox_SelectionChanged"/>
                                        </Grid>
                                </Border>
                        </Grid>
                </Grid>

                <StatusBar x:Name="MainStatusBar"
                           Grid.Row="2">
                        <StatusBar.ItemsPanel>
                                <ItemsPanelTemplate>
                                        <DockPanel LastChildFill="True"/>
                                </ItemsPanelTemplate>
                        </StatusBar.ItemsPanel>
                        <StatusBarItem DockPanel.Dock="Right">
                                <TextBlock x:Name="ClockText"
                                           Text="00:00:00"
                                           Margin="10,0,5,0"/>
                        </StatusBarItem>
                        <StatusBarItem DockPanel.Dock="Right">
                                <TextBlock x:Name="CharCountText"
                                           Text="글자 수: 0"
                                           Margin="10,0,0,0"/>
                        </StatusBarItem>
                        <StatusBarItem DockPanel.Dock="Right">
                                <TextBlock x:Name="CursorPosText"
                                           Text="줄: 1, 칸: 1"
                                           Margin="10,0,0,0"/>
                        </StatusBarItem>
                        <StatusBarItem/>
                </StatusBar>
        </Grid>
</Window>
